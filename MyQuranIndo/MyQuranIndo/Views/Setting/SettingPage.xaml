<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyQuranIndo.Views.Setting.SettingPage"
             xmlns:vm="clr-namespace:MyQuranIndo.ViewModels.Setting"
             xmlns:control="clr-namespace:MyQuranIndo.Controls"
             xmlns:effect="clr-namespace:MyQuranIndo.Effects"
             Title="Pengaturan"
             Shell.PresentationMode="Animated"
             BackgroundColor="LightGray">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout x:DataType="vm:SettingViewModel">
                <control:CustomTableView Intent="Settings"
                                         HasUnevenRows="True"
                                         SeparatorColor="{DynamicResource TextColor}">
                    <TableRoot>
                        <TableSection Title="Transliterasi Latin"
                                      TextColor="{DynamicResource TextColor}">
                            <SwitchCell Text="Aktifkan Transliterasi" 
                                        On="{Binding IsActiveTransliteration, Mode=TwoWay}" 
                                        OnColor="{DynamicResource TextColor}" />
                        </TableSection>
                        <TableSection Title="Terjemahan"
                                      TextColor="{DynamicResource TextColor}">
                            <SwitchCell Text="Aktifkan Terjemahan" 
                                        On="{Binding IsActiveTranslate, Mode=TwoWay}" 
                                        OnColor="{DynamicResource Primary}"                                      
                                        />
                        </TableSection>         
                        <TableSection Title="Tema"
                                      TextColor="{DynamicResource TextColor}">
                            <SwitchCell Text="Ikuti Tema Sistem"
                                        On="{Binding FollowSystemTheme, Mode=TwoWay}"
                                        OnColor="{DynamicResource Primary}" />
                            <SwitchCell Text="Gunakan Mode Gelap"
                                        On="{Binding IsDarkMode, Mode=TwoWay}"
                                        OnColor="{DynamicResource Primary}" />
                        </TableSection>
                        <!--<TableSection Title="Tema">
                            <ViewCell Height="50">
                                <Grid Padding="15,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        --><!-- Label mengambil sisa ruang --><!--
                                        <ColumnDefinition Width="30" />
                                        --><!-- Switch hanya mengambil ruang yang dibutuhkan --><!--
                                    </Grid.ColumnDefinitions>

                                    <Label Text="Ikuti Tema Sistem" 
                                           VerticalOptions="Center" 
                                           TextColor="{DynamicResource TextColor}"/>
                                    <Switch Grid.Column="1"
                                            BackgroundColor="{DynamicResource TextColor}"
                                            IsToggled="{Binding FollowSystemTheme, Mode=TwoWay}"
                                            VerticalOptions="Center" />

                                    <Label Grid.Row="1"
                                           Text="Gunakan Mode Gelap" 
                                           VerticalOptions="Center" 
                                           TextColor="{DynamicResource TextColor}"/>
                                    <Switch Grid.Row="1"
                                            Grid.Column="1"
                                            BackgroundColor="{DynamicResource TextColor}"
                                            IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </ViewCell>
                        </TableSection>-->
                        <TableSection Title="Pilih Warna Aplikasi"
                                      TextColor="{DynamicResource TextColor}">        
                            <ViewCell Height="50">
                                <StackLayout Padding="10,0,10,0"
                                             >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button BackgroundColor="#2196F3"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>0</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="1" 
                                                BackgroundColor="#075e55"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>1</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="2" 
                                                BackgroundColor="#ee4d2d"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>2</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="3" 
                                                HeightRequest="25"
                                                BackgroundColor="#2D2D2B"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>8</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="4" 
                                                HeightRequest="25"
                                                BackgroundColor="#971ABD"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>4</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="5" 
                                                HeightRequest="25"
                                                BackgroundColor="#F70D91"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>5</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="6" 
                                                HeightRequest="25"
                                                BackgroundColor="#e42a5b"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>6</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="7" 
                                                HeightRequest="25"
                                                BackgroundColor="#154c79"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>7</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                    </Grid>
                                </StackLayout>
                            </ViewCell>
                        </TableSection>
                        <!--<TableSection Title="Test">
                            <control:PickerCell>
                                <Picker 
                                            SelectedItem="{Binding FontSizeSelected, Mode=TwoWay}"
                                            ItemsSource="{Binding FontSizes}"
                                            ItemDisplayBinding="{Binding Value}"
                                            CharacterSpacing="2">
                                </Picker>
                            </control:PickerCell>                     
                        </TableSection>-->
                        <TableSection Title="Ukuran Teks Arab"
                                      TextColor="{DynamicResource TextColor}">                            
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0" 
                                                 BackgroundColor="{DynamicResource BgColor}"                                                 >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                                <!--<RowDefinition Height="Auto"/>-->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Kecil"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Sedang"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeMediumColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Besar"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeLargeColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <!--<Label Grid.Row ="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="Contoh:"
                                                   TextColor="{DynamicResource TextColor}"
                                                   Margin="5,10,0,0"/>-->
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding BismillahSample}"
                                                   FontSize="{Binding FontSizeArabic}"
                                                   FontFamily="{Binding FontArabicName}"
                                                   LineHeight="1.4"
                                                   TextColor="{DynamicResource TextColor}"
                                                   BackgroundColor="{DynamicResource BgColor}"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5"/>
                                        </Grid>
                                        <!--</Grid>-->                                    
                                    </StackLayout>                                 
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Ukuran Teks Transliterasi"
                                      TextColor="{DynamicResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Default"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoCaptionColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>3</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Kecil"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Sedang"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoMediumColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Text="Besar"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoLargeColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding BismillahTextIndoSample}"
                                                   FontSize="{Binding FontSizeTextIndo}"
                                                   FontFamily="Montserrat-Light-Italic"
                                                   TextColor="{DynamicResource TextColor}"
                                                   BackgroundColor="{DynamicResource BgColor}"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5" />
                                        </Grid>
                                        <!--</Grid>-->
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Ukuran Teks Terjemahan"
                                      TextColor="{DynamicResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                                <!--<RowDefinition Height="Auto"/>-->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Default"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateCaptionColor}">
                                                    <Button.CommandParameter>
                                                        <x:Int32>3</x:Int32>
                                                    </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Kecil"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Sedang"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateMediumColor}">
                                                    <Button.CommandParameter>
                                                        <x:Int32>1</x:Int32>
                                                    </Button.CommandParameter>
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Text="Besar"
                                                        Command="{Binding FontSizeTranslateCommand}"
                                                        TextColor="{Binding FontSizeTranslateLargeColor}">
                                                <Button.CommandParameter>
                                                        <x:Int32>2</x:Int32>
                                                    </Button.CommandParameter>
                                                </Button>
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding BismillahTranslateSample}"
                                                   FontSize="{Binding FontSizeTranslate}"
                                                   FontFamily="Montserrat-Light-Italic"
                                                   TextColor="{DynamicResource TextColor}"
                                                   BackgroundColor="{DynamicResource BgColor}"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5" />    
                                        </Grid>
                                        <!--</Grid>-->
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Rasm (Penulisan)"
                                      TextColor="{DynamicResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="IndoPak"
                                                    CharacterSpacing="2"
                                                    Command="{Binding RasmCommand}"
                                                    TextColor="{Binding RasmIndoPakColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                Text="Utsmani"
                                                CharacterSpacing="2"
                                                Command="{Binding RasmCommand}"
                                                TextColor="{Binding RasmUtsmaniColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Qari"
                                      TextColor="{DynamicResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="As-Sudais"
                                                    CharacterSpacing="2"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAsSudaisColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Al-Afasy"
                                                    CharacterSpacing="2"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAlAfasyColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Al-Mathrud"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAlMatroudColor}"
                                                    FontSize="Caption">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Tafsir"
                                      TextColor="{DynamicResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Kemenag"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TafsirCommand}"
                                                    TextColor="{Binding TafsirKemenagColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                Text="Al-Jalalain"
                                                CharacterSpacing="2"
                                                Command="{Binding TafsirCommand}"
                                                TextColor="{Binding TafsirAlJalalainColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Lainnya"
                                      TextColor="{DynamicResource TextColor}">
                            <ImageCell Text="Bersihkan Penyimpanan" 
                                       ImageSource="icon_clean.png" 
                                       Command="{Binding ClearCacheTapped}"/>
                            <ImageCell Text="Info Aplikasi" 
                                       ImageSource="icon_about.png" 
                                       Command="{Binding AboutTapped}"/>
                            <ImageCell Text="Berikan Rating"
                                       ImageSource="icon_rating.png"
                                       Command="{Binding OpenAppStoreTapped}"/>
                            <ImageCell Text="Cek Pembaruan"
                                       ImageSource="icon_update.png"
                                       Command="{Binding OpenAppStoreTapped}"/>
                        </TableSection>
                    </TableRoot>
                </control:CustomTableView>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>