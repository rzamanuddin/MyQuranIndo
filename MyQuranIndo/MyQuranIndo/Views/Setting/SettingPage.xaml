<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyQuranIndo.Views.Setting.SettingPage"
             xmlns:vm="clr-namespace:MyQuranIndo.ViewModels.Setting"
             xmlns:control="clr-namespace:MyQuranIndo.Controls"
             xmlns:effect="clr-namespace:MyQuranIndo.Effects"
             Title="Pengaturan"
             Shell.PresentationMode="Animated"
             BackgroundColor="{DynamicResource Accent}">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout x:DataType="vm:SettingViewModel">
                <control:CustomTableView Intent="Settings"
                                         HasUnevenRows="True"
                                         SeparatorColor="{DynamicResource TextColor}">
                    <TableRoot>
                        <!--<TableSection Title="Transliterasi Latin"
                                      TextColor="White">
                            <SwitchCell Text="Aktifkan Transliterasi"
                                        On="{Binding IsActiveTransliteration, Mode=TwoWay}" 
                                        OnColor="White" />
                        </TableSection>
                        <TableSection Title="Terjemahan"
                                      TextColor="White">
                            <SwitchCell Text="Aktifkan Terjemahan" 
                                        On="{Binding IsActiveTranslate, Mode=TwoWay}" 
                                        OnColor="{DynamicResource Primary}"                                      
                                        />
                        </TableSection>-->
                        <TableSection Title="Transliterasi Latin"
                                      TextColor="White">
                            <ViewCell Height="60">
                                <ViewCell.View>
                                    <StackLayout Padding="10,8,10,8" VerticalOptions="Center">
                                        <Grid ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Aktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TransliterationCommand}"
                                                    TextColor="{Binding TransliterationOnColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>True</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Nonaktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TransliterationCommand}"
                                                    TextColor="{Binding TransliterationOffColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>False</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Terjemahan"
                                      TextColor="White">
                            <ViewCell Height="60">
                                <ViewCell.View>
                                    <StackLayout Padding="10,8,10,8" VerticalOptions="Center">
                                        <Grid ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Aktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TranslateCommand}"
                                                    TextColor="{Binding TranslateOnColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>True</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Nonaktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TranslateCommand}"
                                                    TextColor="{Binding TranslateOffColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>False</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <!--<TableSection Title="Tema"
                                      TextColor="White">
                            <SwitchCell Text="Ikuti Tema Sistem"
                                        On="{Binding FollowSystemTheme, Mode=TwoWay}"
                                        OnColor="{DynamicResource Primary}" />
                            <SwitchCell Text="Gunakan Mode Gelap"
                                        On="{Binding IsDarkMode, Mode=TwoWay}"
                                        OnColor="{DynamicResource Primary}" />
                        </TableSection>-->
                        <TableSection Title="Tema"
              TextColor="White">
                            <ViewCell Height="90">
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,8" Spacing="8">
                                        <Label Text="Ikuti Tema Sistem"
                       TextColor="White"
                       FontAttributes="Bold" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Aktif"
                            CharacterSpacing="2"
                            Command="{Binding FollowSystemThemeCommand}"
                            TextColor="{Binding FollowSystemThemeOnColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>True</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                            Text="Nonaktif"
                            CharacterSpacing="2"
                            Command="{Binding FollowSystemThemeCommand}"
                            TextColor="{Binding FollowSystemThemeOffColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>False</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                            <ViewCell Height="90">
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,8" Spacing="8">
                                        <Label Text="Gunakan Mode Gelap"
                       TextColor="White"
                       FontAttributes="Bold" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Aktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding DarkModeCommand}"
                                                    TextColor="{Binding DarkModeOnColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>True</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Nonaktif"
                                                    CharacterSpacing="2"
                                                    Command="{Binding DarkModeCommand}"
                                                    TextColor="{Binding DarkModeOffColor}">
                                                <Button.CommandParameter>
                                                    <x:Boolean>False</x:Boolean>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Pilih Warna Aplikasi"
                                      TextColor="White">
                            <ViewCell Height="60">
                                <StackLayout Padding="10,10,10,10"
                                             >
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button BackgroundColor="#2196F3"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>0</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="1" 
                                                BackgroundColor="#075e55"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>1</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="2" 
                                                BackgroundColor="#ee4d2d"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>2</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="3" 
                                                HeightRequest="25"
                                                BackgroundColor="#2D2D2B"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>8</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="4" 
                                                HeightRequest="25"
                                                BackgroundColor="#971ABD"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>4</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="5" 
                                                HeightRequest="25"
                                                BackgroundColor="#F70D91"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>5</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="6" 
                                                HeightRequest="25"
                                                BackgroundColor="#e42a5b"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>6</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                        <Button Grid.Column="7" 
                                                HeightRequest="25"
                                                BackgroundColor="#154c79"
                                                Command="{Binding ColorThemeCommand}">
                                            <Button.CommandParameter>
                                                <x:Int32>7</x:Int32>
                                            </Button.CommandParameter>
                                        </Button>
                                    </Grid>
                                </StackLayout>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Ukuran Teks Arab"
                                      TextColor="White">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10" 
                                                 BackgroundColor="{DynamicResource Accent}"                                                 >
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                                <!--<RowDefinition Height="Auto"/>-->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Kecil"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Sedang"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeMediumColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Besar"
                                                    CharacterSpacing="2"
                                                    Command="{Binding FontSizeCommand}"
                                                    TextColor="{Binding FontSizeLargeColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <!--<Label Grid.Row ="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="Contoh:"
                                                   TextColor="{DynamicResource TextColor}"
                                                   Margin="5,10,0,0"/>-->
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding BismillahSample}"
                                                   FontSize="{Binding FontSizeArabic}"
                                                   FontFamily="{Binding FontArabicName}"
                                                   LineHeight="1.4"
                                                   TextColor="White"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5"/>
                                        </Grid>
                                        <!--</Grid>-->
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Ukuran Teks Transliterasi"
                                      TextColor="White">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Default"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoCaptionColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>3</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Kecil"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Sedang"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoMediumColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Text="Besar"
                                                    Command="{Binding FontSizeTextIndoCommand}"
                                                    TextColor="{Binding FontSizeTextIndoLargeColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding BismillahTextIndoSample}"
                                                   FontSize="{Binding FontSizeTextIndo}"
                                                   FontFamily="Montserrat-Light-Italic"
                                                   TextColor="White"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5" />
                                        </Grid>
                                        <!--</Grid>-->
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Ukuran Teks Terjemahan"
                                      TextColor="White">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="Auto"/>
                                                <!--<RowDefinition Height="Auto"/>-->
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Default"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateCaptionColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>3</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Kecil"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateSmallColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Sedang"
                                                    Command="{Binding FontSizeTranslateCommand}"
                                                    TextColor="{Binding FontSizeTranslateMediumColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="3"
                                                        Text="Besar"
                                                        Command="{Binding FontSizeTranslateCommand}"
                                                        TextColor="{Binding FontSizeTranslateLargeColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Label Grid.Row ="1" 
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding BismillahTranslateSample}"
                                                   FontSize="{Binding FontSizeTranslate}"
                                                   FontFamily="Montserrat-Light-Italic"
                                                   TextColor="White"
                                                   HorizontalTextAlignment="Center"
                                                   Padding="5" />
                                        </Grid>
                                        <!--</Grid>-->
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Rasm (Penulisan)"
                                      TextColor="{StaticResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="IndoPak"
                                                    CharacterSpacing="2"
                                                    Command="{Binding RasmCommand}"
                                                    TextColor="{Binding RasmIndoPakColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                Text="Utsmani"
                                                CharacterSpacing="2"
                                                Command="{Binding RasmCommand}"
                                                TextColor="{Binding RasmUtsmaniColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Qari"
                                      TextColor="{StaticResource TextColor}">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="As-Sudais"
                                                    CharacterSpacing="2"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAsSudaisColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Text="Al-Afasy"
                                                    CharacterSpacing="2"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAlAfasyColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Text="Al-Mathrud"
                                                    Command="{Binding ReciterCommand}"
                                                    TextColor="{Binding ReciterAlMatroudColor}"
                                                    FontSize="Caption">
                                                <Button.CommandParameter>
                                                    <x:Int32>2</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Tafsir"
                                      TextColor="White">
                            <ViewCell>
                                <ViewCell.View>
                                    <StackLayout Padding="10,10,10,10">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button Text="Kemenag"
                                                    CharacterSpacing="2"
                                                    Command="{Binding TafsirCommand}"
                                                    TextColor="{Binding TafsirKemenagColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>0</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Grid.Column="1"
                                                Text="Al-Jalalain"
                                                CharacterSpacing="2"
                                                Command="{Binding TafsirCommand}"
                                                TextColor="{Binding TafsirAlJalalainColor}">
                                                <Button.CommandParameter>
                                                    <x:Int32>1</x:Int32>
                                                </Button.CommandParameter>
                                            </Button>
                                        </Grid>
                                    </StackLayout>
                                </ViewCell.View>
                            </ViewCell>
                        </TableSection>
                        <TableSection Title="Lainnya"
                                      TextColor="White">
                            <ImageCell Text="Bersihkan Penyimpanan" 
                                       ImageSource="icon_clean.png"
                                       TextColor="White"
                                       Command="{Binding ClearCacheTapped}"/>
                            <ImageCell Text="Info Aplikasi" 
                                       ImageSource="icon_about.png" 
                                       TextColor="White"
                                       Command="{Binding AboutTapped}"/>
                            <ImageCell Text="Berikan Rating"
                                       ImageSource="icon_rating.png"
                                       TextColor="White"
                                       Command="{Binding OpenAppStoreTapped}"/>
                            <ImageCell Text="Cek Pembaruan"
                                       ImageSource="icon_update.png"
                                       TextColor="White"
                                       Command="{Binding OpenAppStoreTapped}"/>
                        </TableSection>
                    </TableRoot>
                </control:CustomTableView>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>