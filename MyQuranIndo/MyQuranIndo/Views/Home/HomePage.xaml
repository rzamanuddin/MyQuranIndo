<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyQuranIndo.Views.Home.HomePage"
             xmlns:vm="clr-namespace:MyQuranIndo.ViewModels.Home"
             Title="{Binding Title, Mode=TwoWay}"
             BackgroundColor="{DynamicResource BgColor}"             
             >
    <!--<RelativeLayout Padding="0"
                    ">
        --><!--<Image
            Aspect="Fill"
            Source="quran_background.png"
            RelativeLayout.WidthConstraint= "{ConstraintExpression Type=RelativeToParent, Property=Width}"
            RelativeLayout.HeightConstraint= "{ConstraintExpression Type=RelativeToParent, Property=Height}"
            >
            
        </Image>--><!--
    </RelativeLayout>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="ContentLayout" Value="Top" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
                <Setter Property="VerticalOptions" Value="FillAndExpand" />
                <Setter Property="Padding">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="Thickness" 
                                 Phone="5, 10, 5, 10" 
                                 Tablet="10, 20, 10, 20" />
                    </Setter.Value>
                </Setter>
                <Setter Property="HeightRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" 
                                 Phone="100" 
                                 Tablet="120" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GridStyle"
                   TargetType="Grid">
                <Setter Property="WidthRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="GridLength"
                                 Phone="*"
                                 Tablet="*"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="Thickness"
                                 Phone="10"
                                 Tablet="40"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="ColumnSpacing">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double"
                                 Phone="2"
                                 Tablet="10"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="RowSpacing">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double"
                                 Phone="2"
                                 Tablet="10"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>        
        <ScrollView>
                <StackLayout Spacing="2"
                             Padding="0" 
                             Margin="0, 0, 0, 0"
                             VerticalOptions="CenterAndExpand"
                             HorizontalOptions="CenterAndExpand"
                             x:DataType="vm:HomeViewModel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"  />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" 
                          Grid.Column="0"
                          Margin="2" 
                          Style="{StaticResource GridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackLayout  Grid.Row="0" 
                                      Grid.Column="0" 
                                      HorizontalOptions="FillAndExpand"  
                                      VerticalOptions="FillAndExpand"
								      Padding="5">
                            <Button ImageSource="icon_quran.png"
								    Text="Baca Surat"  
									CharacterSpacing="2"
                                    Command="{Binding SurahTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <!--<StackLayout Grid.Row="0" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand"  
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_quran_2.png" 
								    Text="Baca Surat (Mode Tab)"  
									CharacterSpacing="3"
                                    Command="{Binding SurahTabTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>-->
                        <StackLayout  Grid.Row="0" 
                                      Grid.Column="1" 
                                      HorizontalOptions="FillAndExpand" 
                                      VerticalOptions="FillAndExpand"
								      Padding="5">
                            <Button ImageSource="icon_juz.png" 
								    Text="Baca Juz"  
									CharacterSpacing="2"
                                    Command="{Binding JuzTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <!--<StackLayout Grid.Row="1" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand"  
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_juz_2.png" 
								    Text="Baca Juz (Mode Tab)"    
									CharacterSpacing="4"
                                    Command="{Binding JuzTabTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>-->
                        <StackLayout Grid.Row="1" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand"  
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_tafsir.png" 
								    Text="Baca Tafsir"     
									CharacterSpacing="2"
                                    Command="{Binding TafsirTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="1" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand"  
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_juz_2.png" 
								    Text="Baca Juz 'Amma"     
									CharacterSpacing="2"
                                    Command="{Binding JuzAmmaTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="2" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand"  
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_quran_2.png" 
								    Text="Baca Surat Populer"    
									CharacterSpacing="3"
                                    Command="{Binding SurahPopularTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="2" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_last_read.png" 
								    Text="Terakhir Dibaca"
									CharacterSpacing="4"
                                    Command="{Binding LastReadTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="3" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_bookmark.png" 
								    Text="Bookmark"
									CharacterSpacing="4"      
                                    Command="{Binding BookmarkTapped}"
                                    Style="{StaticResource MenuButtonStyle}"         
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="3" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_find.png" 
								    Text="Pencarian"
									CharacterSpacing="4"      
                                    Command="{Binding FindTapped}"
                                    Style="{StaticResource MenuButtonStyle}"       
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="4" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_pray.png" 
								    Text="Kumpulan Do'a"
								    CharacterSpacing="2"
                                    Command="{Binding PrayTapped}"
                                    Style="{StaticResource MenuButtonStyle}" />
                        </StackLayout>
                        <StackLayout Grid.Row="4" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_hadith.png" 
								    Text="Kumpulan Hadis"
								    CharacterSpacing="2"
                                    Command="{Binding HadithTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="5" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_sunrise.png" 
								    Text="Dzikir Pagi"
								    CharacterSpacing="2"
                                    Command="{Binding ZikrMorningTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="5" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_sunset.png" 
								    Text="Dzikir Petang"
								    CharacterSpacing="2"
                                    Command="{Binding ZikrEveningTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="6" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_allah.png" 
								    Text="Asmaul Husna"
								    CharacterSpacing="2"
                                    Command="{Binding AsmaulHusnaTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="6" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_allah_2.png" 
								    Text="Bacaan Sholat"
								    CharacterSpacing="2"
                                    Command="{Binding IntentionTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="7" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_clock.png" 
								    Text="Jadwal Sholat"
								    CharacterSpacing="2"
                                    Command="{Binding PrayerScheduleTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="7" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_kaaba.png" 
								    Text="Arah Kiblat"
								    CharacterSpacing="2"
                                    Command="{Binding QiblaTapped}"
                                    Style="{StaticResource MenuButtonStyle}"/>
                        </StackLayout>
                        <StackLayout Grid.Row="8" 
                                     Grid.Column="0" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_help.png" 
								    Text="Petunjuk" 
									CharacterSpacing="4"   
                                    Command="{Binding HelpTapped}"  
                                    Style="{StaticResource MenuButtonStyle}"                     
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="8" 
                                     Grid.Column="1" 
                                     HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_setting.png" 
								    Text="Pengaturan"
									CharacterSpacing="3"  
                                    Command="{Binding SettingTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="9" 
                                     Grid.Column="0"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_about.png" 
								    Text="Info Aplikasi"
								    CharacterSpacing="2"
                                    Command="{Binding AboutTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                        <StackLayout Grid.Row="9" 
                                     Grid.Column="1"
                                     HorizontalOptions="FillAndExpand"
                                     VerticalOptions="FillAndExpand"
								     Padding="5">
                            <Button ImageSource="icon_donate.png" 
								    Text="Donasi"
								    CharacterSpacing="2"
                                    Command="{Binding DonateTapped}"
                                    Style="{StaticResource MenuButtonStyle}"
									 />
                        </StackLayout>
                    </Grid>
                </Grid>
            </StackLayout>            
        </ScrollView>
    </ContentPage.Content>
</ContentPage>