<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyQuranIndo.ViewModels.Surah"  
             xmlns:model="clr-namespace:MyQuranIndo.Models.Qurans" 
             xmlns:localBehavior="clr-namespace:MyQuranIndo.Behaviors"             
             xmlns:control="clr-namespace:MyQuranIndo.Controls"           
             xmlns:selector="clr-namespace:MyQuranIndo.Selectors"
             x:Class="MyQuranIndo.Views.Surah.SurahDetailPage"
             BackgroundColor="{DynamicResource BgColor}"
             Title="{Binding Title, Mode=TwoWay}">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
        Command="{Binding GoBackCommand}"
        IsEnabled="True"         
            />
    </Shell.BackButtonBehavior>
    <!--<ContentPage.BindingContext>
        <local:SurahDetailViewModel/>
    </ContentPage.BindingContext>-->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ImageButtonStyle" TargetType="ImageButton">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="WidthRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" 
                                 Phone="32" 
                                 Tablet="64" />
                    </Setter.Value>
                </Setter>
                <Setter Property="HeightRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" 
                                 Phone="32" 
                                 Tablet="64" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="BackgroundColor" Value="LightGray" />
                <Setter Property="ProgressColor" Value="{DynamicResource TextColor}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="HeightRequest">
                    <Setter.Value>
                        <OnIdiom x:TypeArguments="x:Double" 
                                 Phone="4" 
                                 Tablet="12" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
        <DataTemplate x:Key="evenTemplate">
            <ViewCell>
                <StackLayout Padding="0" 
                             x:DataType="model:Ayah"
                             Spacing="0">
                    <control:GridSurahDetail />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer 
                                            NumberOfTapsRequired="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:SurahDetailViewModel}}, Path=AyahOneTapped}"		
                                            CommandParameter="{Binding .}">
                        </TapGestureRecognizer>
                        <TapGestureRecognizer 
                                            NumberOfTapsRequired="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:SurahDetailViewModel}}, Path=AyahTwoTapped}"		
                                            CommandParameter="{Binding .}">
                        </TapGestureRecognizer>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </ViewCell>
        </DataTemplate>
        <!--<DataTemplate x:Key="unEvenTemplate">
            <ViewCell>
                <StackLayout Padding="0" 
                             x:DataType="model:Ayah"
                             Spacing="0">
                    <control:GridSurahDetail />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer 
                                            NumberOfTapsRequired="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:SurahDetailViewModel}}, Path=AyahOneTapped}"		
                                            CommandParameter="{Binding .}">
                        </TapGestureRecognizer>
                        <TapGestureRecognizer 
                                            NumberOfTapsRequired="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:SurahDetailViewModel}}, Path=AyahTwoTapped}"		
                                            CommandParameter="{Binding .}">
                        </TapGestureRecognizer>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </ViewCell>
        </DataTemplate>
        <selector:AlternateColorDataTemplateSelector x:Key="alternateColorDataTemplateSelector"
                                                     EvenTemplate="{DynamicResource evenTemplate}"
                                                     UnevenTemplate="{DynamicResource unEvenTemplate}">            
        </selector:AlternateColorDataTemplateSelector>-->
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="icon_setting_bw.png"
                     x:DataType="local:SurahDetailViewModel"
                     Command="{Binding SettingTapped}"
        />
    </ContentPage.ToolbarItems>
    <Shell.SearchHandler>
        <SearchHandler x:DataType="local:SurahDetailViewModel"
                       x:Name="searchBar"
                       Placeholder="Cari Kata Kunci"
                       Command="{Binding SearchCommand}" 
                       CommandParameter="{Binding Query, Source={x:Reference searchBar}}"                                           
                       SearchBoxVisibility="Collapsible"
                       BackgroundColor="{DynamicResource BgColor}"
                       TextColor="{DynamicResource TextColor}"    
                       PlaceholderColor="LightGray"                   
                       >
        </SearchHandler>
    </Shell.SearchHandler>
    <ContentPage.Content>
        <StackLayout Spacing="3" 
                     Padding="10"
                     x:DataType="local:SurahDetailViewModel"
                     BackgroundColor="{DynamicResource BgColor}">
            <Grid ColumnDefinitions="Auto, *"
                  ColumnSpacing="8"
                  Padding="8"
                  VerticalOptions="Start"
                  HorizontalOptions="FillAndExpand">
                <SearchBar x:Name="searchBar2"
                           Grid.Column="0"
                           Placeholder="Cari Kata Kunci"
                           SearchCommand="{Binding SearchCommand}"
                           SearchCommandParameter="{Binding Text, Source={x:Reference searchBar2}}"
                           FontSize="Medium"
                           BackgroundColor="{DynamicResource BgColor}"
                           TextColor="{DynamicResource TextColor}"
                           Margin="0, 0, 0, 2"
                           IsVisible="{Binding VisibleSearchBar}"
                           PlaceholderColor="LightGray"
                       >
                    <SearchBar.Behaviors>
                        <localBehavior:TextChangedBehavior />
                    </SearchBar.Behaviors>
                </SearchBar>
                <ImageButton Grid.Column="1"
                             Command="{Binding SettingTapped}"
                             Style="{DynamicResource ImageButtonStyle}"
                             x:DataType="local:SurahDetailViewModel">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#x2699;" 
                                            Color="{DynamicResource TextColor}" 
                                            Size="20" />
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
            <BoxView BackgroundColor="{DynamicResource TextColor}"
                     HeightRequest="3"
                     Margin="0, -6, 0, 1" 
                     IsVisible="{Binding VisibleSearchBar}"
                     />
            <Frame BorderColor="{DynamicResource TextColor}"
                   BackgroundColor="Transparent"
                   CornerRadius="8"
                   HasShadow="False"
                   Padding="0"
                   VerticalOptions="Start"
                   HorizontalOptions="FillAndExpand"
                   Margin="0,8,0,8">

                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="8"
                      Padding="8"
                      VerticalOptions="Start"
                      HorizontalOptions="FillAndExpand">

                    <!-- Kolom 0: Tombol Play & Stop -->
                    <StackLayout Grid.Column="0" 
                             Orientation="Horizontal" 
                             Spacing="2" 
                             VerticalOptions="Center"
                             HorizontalOptions="Start">
                        <ImageButton Command="{Binding TogglePlayCommand}"
                                 Style="{DynamicResource ImageButtonStyle}"
                                 IsEnabled="{Binding IsPlayerEnabled}">
                            <ImageButton.Source>
                                <FontImageSource Glyph="{Binding PlayButtonIcon}" Color="{DynamicResource TextColor}" Size="20" />
                            </ImageButton.Source>
                        </ImageButton>
                        <ImageButton Command="{Binding StopMP3Command}"
                                 Style="{DynamicResource ImageButtonStyle}"
                                 IsVisible="{Binding IsStopVisibled}">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#x25A0;" Color="{DynamicResource TextColor}" Size="20" />
                            </ImageButton.Source>
                        </ImageButton>
                    </StackLayout>

                    <!-- Kolom 1: ProgressBar otomatis mengisi sisa lebar layar ke kanan -->
                    <ProgressBar Grid.Column="1"
                             Progress="{Binding Progress, Mode=TwoWay}"
                             Style="{DynamicResource ProgressBarStyle}"
                             IsVisible="{Binding VisibleProgressBar}" />
                </Grid>
            </Frame>
            <RefreshView Command="{Binding LoadCommand}" 
                         x:DataType="local:SurahDetailViewModel"
                         IsRefreshing="{Binding IsBusy, Mode=TwoWay}"
                         RefreshColor="{DynamicResource Primary}">
                <ListView x:Name="collAyah"
                          ItemsSource="{Binding Ayahs}"                          
                          SelectionMode="Single"
                          HasUnevenRows="True"
                          CachingStrategy="RecycleElement"
                          ItemTemplate="{DynamicResource evenTemplate}"
                          SeparatorVisibility="None"
                          SeparatorColor="{DynamicResource TextColor}">
                    <ListView.Header>
                        <StackLayout>
                            <Label Text="{Binding SubTitle}"
                                    FontSize="Medium"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    FontFamily="Montserrat-Medium"
                                    BackgroundColor="{DynamicResource Accent}"
                                    TextColor="{DynamicResource TextColor}"
                                    Padding="5"/>
                        </StackLayout>
                    </ListView.Header>
                </ListView>
            </RefreshView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>